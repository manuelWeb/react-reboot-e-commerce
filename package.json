    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
